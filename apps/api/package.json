{
  "name": "@codex-health/api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP API (facility-scoped, RLS-backed). M2: manual fact entry behind the local auth stub.",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
