# Codex Health: local environment template.
#
# Copy to .env (scripts/dev/up.sh does this for you). .env is git-ignored; .env.example is the only env file in git.
# NO real credential, key, account id, hostname or patient data may ever be placed in a local environment.
# Local development runs on synthetic data only (CONSTRAINTS.md; research/dev-alignment.md row 0.11).
# Values below are placeholders that only work against the docker-compose.yml services on 127.0.0.1.

# --- Runtime ---------------------------------------------------------------
# development | test. Production configuration never lives in a .env file; it comes from AWS (Terraform + Secrets Manager).
NODE_ENV=development
# Log verbosity for local services: error | warn | info | debug. Logs must never contain PHI at any level.
LOG_LEVEL=info

# --- Database (docker compose "postgres") ------------------------------------
# Connection used by migrations, the synthetic seed and the db tests. Role codex_migrator owns the schema.
# The password is the local placeholder from packages/db/sql/init/001_roles_and_database.sql.
DATABASE_URL=postgres://codex_migrator:migrator-local-only@127.0.0.1:5432/codex_health
# Connections the API and the worker will use at M1. Neither role can bypass row-level security.
DATABASE_URL_APP=postgres://codex_app:app-local-only@127.0.0.1:5432/codex_health
DATABASE_URL_WORKER=postgres://codex_worker:worker-local-only@127.0.0.1:5432/codex_health

# --- AWS emulation (docker compose "localstack") -----------------------------
# Region every local AWS call targets. Production is pinned to US regions by Terraform.
AWS_REGION=us-east-1
# Points every AWS SDK client at LocalStack. Unset in AWS environments.
AWS_ENDPOINT_URL=http://127.0.0.1:4566
# LocalStack accepts any credentials; "test" is its documented placeholder. Never put real IAM keys here.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Bucket for referral documents (created by scripts/dev/localstack-init/01-create-resources.sh).
S3_DOCUMENTS_BUCKET=codex-health-documents-local
# Processing queue and its dead-letter queue. 000000000000 is LocalStack's fake account id, not a real one.
SQS_PROCESSING_QUEUE_URL=http://127.0.0.1:4566/000000000000/codex-healthcessing
SQS_PROCESSING_DLQ_URL=http://127.0.0.1:4566/000000000000/codex-healthcessing-dlq

# --- AI ---------------------------------------------------------------------
# Production AI calls go only to AWS Bedrock with a pinned model id (founder decision; set when chosen).
# Local development never calls Bedrock, Textract, OpenAI or Anthropic; extraction runs against fixtures.
BEDROCK_MODEL_ID=REPLACE_WITH_PINNED_BEDROCK_MODEL_ID
