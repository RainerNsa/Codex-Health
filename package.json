{
  "name": "codex-health",
  "version": "0.0.0",
  "private": true,
  "description": "Codex Health: AI reads the referral packet, the facility's criteria make the call, staff decide.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "check": "node scripts/checks/run-all.mjs",
    "check:fast": "node scripts/checks/run-all.mjs --fast",
    "check:constraints": "node scripts/checks/run-all.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm test --prefix scripts/checks && node --test \"infra/scripts/*.test.mjs\"",
    "build": "npm run build --workspaces --if-present",
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.15.0"
  }
}
